#define DEFAULT 0
#define SYM     1
#define FUN     2
#define MOUSE   3
#define SCROLL  4
#define SNIPE   5

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&nice_view_spi { cs-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>; };

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        enter_combo {
            bindings = <&kp ENTER>;
            key-positions = <31 32>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <32 33>;
        };
    };

    macros {
        ctrl_arrow_left: ctrl_arrow_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "CTRL_ARROW_LEFT";
        };

        ctrl_arrow_right: ctrl_arrow_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp RIGHT_ARROW>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "CTRL_ARROW_RIGHT";
        };

        ctrl_arrow_up: ctrl_arrow_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "CTRL_ARROW_UP";
        };

        ctrl_arrow_down: ctrl_arrow_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp DOWN_ARROW>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "CTRL_ARROW_DOWN";
        };

        mac_screen_lock: mac_screen_lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp Q>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_COMMAND>;

            label = "MAC_SCREEN_LOCK";
        };

        print_screen: print_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT &kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp NUMBER_4>,
                <&macro_release>;

            label = "PRINT_SCREEN";
        };

        type_test_credit_card: type_test_credit_card {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp NUMBER_4 &kp NUMBER_7 &kp NUMBER_4 &kp NUMBER_7 &kp NUMBER_4 &kp NUMBER_7 &kp NUMBER_4 &kp NUMBER_7 &kp NUMBER_4 &kp NUMBER_7 &kp NUMBER_4 &kp NUMBER_7 &kp NUMBER_4 &kp NUMBER_7 &kp NUMBER_4 &kp NUMBER_7 &kp NUMBER_9 &kp NUMBER_9 &kp NUMBER_9 &kp NUMBER_9 &kp NUMBER_9 &kp NUMBER_9>,
                <&macro_tap>,
                <&macro_release>;

            label = "TYPE_TEST_CREDIT_CARD";
            wait-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp ESC         &kp N1    &kp N2           &kp N3            &kp N4        &kp N5                                             &kp N6           &kp N7  &kp N8     &kp N9   &kp N0          &kp EQUAL
&lt 1 TAB       &kp Q     &kp W            &kp E             &kp R         &kp T                                              &kp Y            &kp U   &kp I      &kp O    &kp P           &kp MINUS
&kp CAPS        &kp A     &kp S            &kp D             &kp F         &kp G                                              &kp H            &kp J   &kp K      &kp L    &kp SEMICOLON   &kp SQT
&kp LEFT_SHIFT  &kp Z     &kp X            &kp C             &kp V         &kp B             &lt 7 LC(UP_ARROW)  &lt 1 B      &kp N            &kp M   &kp COMMA  &kp DOT  &kp SLASH       &lt 3 UP_ARROW
&lt 9 GRAVE     &lt 10 Z  &lt 8 BACKSLASH  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp SPACE           &lt 1 ENTER  &lt 2 BACKSPACE                              &kp LEFT_ARROW  &kp RIGHT_ARROW
            >;
        };

        number_layer {
            bindings = <
&trans  &kp N1    &kp N2    &kp N3  &kp N4     &kp N5                  &kp N6  &kp N7          &kp N8          &kp N9           &kp N0  &trans
&trans  &trans    &trans    &trans  &trans     &trans                  &trans  &trans          &kp UP_ARROW    &trans           &trans  &trans
&trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans                  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans    &trans    &trans  &trans     &trans  &trans  &trans  &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans    &trans    &trans  &trans     &trans  &trans  &trans  &trans                                                   &trans  &trans
            >;

            label = "NUM";
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&trans     &kp EXCLAMATION  &kp AT_SIGN    &kp HASH          &kp DOLLAR  &kp PERCENT                  &kp LCTRL       &kp AMPERSAND  &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS  &kp PLUS
&trans     &trans           &kp ASTERISK   &kp HASH          &trans      &trans                       &kp PIPE        &kp AMPERSAND  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PERCENT            &kp UNDERSCORE
&trans     &kp EXCLAMATION  &kp LESS_THAN  &kp GREATER_THAN  &trans      &trans                       &kp MINUS       &kp EQUAL      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp COLON              &kp DOUBLE_QUOTES
&trans     &kp CARET        &trans         &trans            &trans      &trans       &trans  &trans  &kp UNDERSCORE  &kp PLUS       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION           &trans
&kp TILDE  &trans           &trans         &trans            &trans      &trans       &trans  &trans  &trans                                                                      &trans                 &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                         &trans  &trans  &trans  &trans  &kp LS(C_BRIGHTNESS_INC)  &kp C_VOL_UP
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans                         &trans  &trans  &trans  &trans  &kp C_BRIGHTNESS_DEC      &kp C_VOL_DN
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans                         &trans  &trans  &trans  &trans  &trans                    &kp C_MUTE
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &print_screen  &trans  &trans  &trans  &trans  &trans  &trans                    &kp C_PLAY_PAUSE
&trans  &trans  &trans   &trans   &trans   &trans  &trans         &trans  &trans                          &trans                    &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &mkp LCLK  &mo 5   &mkp RCLK  &mkp MCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                &trans     &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };

        window_switch_mac {
            bindings = <
&mac_screen_lock  &trans  &trans  &trans  &trans  &trans                  &trans  &trans            &trans          &trans             &trans  &print_screen
&trans            &trans  &trans  &trans  &trans  &trans                  &trans  &trans            &trans          &trans             &trans  &trans
&trans            &trans  &trans  &trans  &trans  &trans                  &trans  &ctrl_arrow_left  &ctrl_arrow_up  &ctrl_arrow_right  &trans  &trans
&trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans          &trans             &trans  &trans
&trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                       &trans  &trans
            >;
        };

        bt_layer {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans                          &trans  &trans
            >;
        };

        window_switch_linux {
            bindings = <
&trans          &trans  &trans  &trans  &trans  &trans                  &trans  &trans                  &trans  &trans               &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans                  &trans  &trans                  &trans  &trans               &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans                  &trans  &kp LS(LC(LEFT_ARROW))  &trans  &kp LS(LC(RIGHT))    &trans  &trans
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LS(LEFT_ARROW)      &trans  &kp LS(RIGHT_ARROW)  &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                       &trans  &trans
            >;
        };

        macro_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                            &trans                  &trans  &trans  &trans  &trans  &print_screen
&trans  &trans  &trans  &trans  &trans  &trans                            &type_test_credit_card  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                            &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mac_screen_lock  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans                                          &trans  &trans
            >;
        };
    };
};
